# ---------------------------------------------------------------------------
# Inference engine
#   ollama : default; simplest setup. Linux/NVIDIA and macOS/Apple Silicon (Metal).
#   vllm   : fastest on NVIDIA GPUs. Downloads Hugging Face models from the Models tab and
#            starts `vllm serve` on the selected GPU when a review needs it (Linux only).
#   openai : any OpenAI-compatible server you run yourself (LM Studio, llama.cpp server, SGLang).
# ---------------------------------------------------------------------------
SIBYL_ENGINE=ollama

# Reviews and their PDFs. Default: backend/sibyl_storage, whatever directory the server starts in.
# SIBYL_STORAGE_PATH=/data/sibyl_storage

# Context window (prompt + output tokens), capped by the model's own limit (Ollama and vLLM). Reviews always get the whole
# window and may write until it is full: there is no output-token limit. Papers too long to leave room for the review
# are trimmed from the end (references/appendix). 32k fits almost every paper; lower it on small GPUs / 16 GB Macs.
# "model" uses each model's full limit (often 128k): the engine reserves memory for the whole window, so only use it
# with plenty of VRAM. With the openai engine, or when a model's limit is unknown, "model" means 32768.
SIBYL_MAX_CONTEXT=32768
# Default review length: auto (the model decides; no guidance) | concise | standard | detailed. The levels steer the
# model through the prompt; none is a token limit.
# SIBYL_REVIEW_DETAIL=auto
# Default generation mode: single (whole review in one call) | sections (one call per section or form question, then
# the scores; longer, more thorough reviews from small models, but several times slower). Custom forms always use single.
# The web app can change both per review.
# SIBYL_REVIEW_MODE=single
SIBYL_TEMPERATURE=0.7
# Lower temperature for conference templates and custom review forms.
SIBYL_FORM_TEMPERATURE=0.2

# Figures: a vision-language model (VLM) describes each figure image, and the reviewer reads the
# descriptions in place of the images. Defaults: qwen2.5vl:7b (ollama), Qwen/Qwen2.5-VL-7B-Instruct (vllm),
# none (openai: set it to a VLM your server runs). "none" disables the step. The VLM is downloaded on first
# use unless SIBYL_VLM_AUTO_PULL=false.
# SIBYL_VLM_MODEL=qwen2.5vl:7b
# SIBYL_VLM_AUTO_PULL=true
# SIBYL_VLM_MAX_FIGURES=24
# SIBYL_VLM_MAX_IMAGE_SIDE=1280

# Related work: before reviewing, the review model writes a few keyword searches from the paper's opening, Sibyl runs
# them on arXiv, and the model picks the most relevant results. The reviewer sees their abstracts and cites them as
# [R1], [R2], ... to judge novelty. Only the search keywords leave the machine, never the paper. Needs internet;
# if arXiv is unreachable the review goes ahead without it. The web app can turn it off per review.
# SIBYL_RELATED_WORK=true
# SIBYL_RELATED_WORK_QUERIES=4
# SIBYL_RELATED_WORK_RESULTS_PER_QUERY=10
# SIBYL_RELATED_WORK_MAX_PAPERS=8
# SIBYL_ARXIV_INTERVAL=3        # seconds between arXiv API calls (arXiv's limit)

# Library search embeddings: "ollama" (nomic-embed-text, pulled automatically) or "local"
# (bundled MiniLM, no server). Defaults to ollama with the Ollama engine, local otherwise.
# SIBYL_EMBEDDINGS=ollama

# --- Ollama -----------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Multi-GPU: one Ollama server per GPU, comma separated (GPU n in the UI -> n-th host).
# OLLAMA_HOSTS=http://ollama-0:11434,http://ollama-1:11434
# How long a model stays loaded after a review ("0" frees VRAM immediately, "10m" avoids reloads).
OLLAMA_KEEP_ALIVE=0

# --- vLLM -------------------------------------------------------------------
# HF_TOKEN=hf_...                      # needed for gated models (Llama, Gemma)
# SIBYL_VLLM_COMMAND=vllm              # e.g. "/opt/vllm-venv/bin/vllm" or "uvx vllm"
# SIBYL_VLLM_GPUS=0,1,2,3              # default: all NVIDIA GPUs
# SIBYL_VLLM_GPU_MEMORY_UTILIZATION=0.80
# SIBYL_VLLM_BASE_PORT=8100            # GPU n listens on base + n
# SIBYL_VLLM_EXTRA_ARGS=--enable-prefix-caching
# SIBYL_VLLM_STARTUP_TIMEOUT=1200

# --- OpenAI-compatible server ------------------------------------------------
# SIBYL_OPENAI_BASE_URL=http://localhost:1234/v1   # LM Studio default
# SIBYL_OPENAI_API_KEY=

# --- GROBID (optional metadata extraction) ----------------------------------
GROBID_ENABLED=false
GROBID_URL=http://localhost:8070
