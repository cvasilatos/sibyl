# ---------------------------------------------------------------------------
# Inference engine
#   ollama : default; simplest setup. Linux/NVIDIA and macOS/Apple Silicon (Metal).
#   vllm   : fastest on NVIDIA GPUs. Downloads Hugging Face models from the Models tab and
#            starts `vllm serve` on the selected GPU when a review needs it (Linux only).
#   openai : any OpenAI-compatible server you run yourself (LM Studio, llama.cpp server, SGLang).
# ---------------------------------------------------------------------------
SIBYL_ENGINE=ollama

# Context window (prompt + output tokens). Papers longer than this are trimmed from the end
# (references/appendix). 32k fits almost every paper; lower it on small GPUs / 16 GB Macs.
SIBYL_MAX_CONTEXT=32768
SIBYL_MAX_OUTPUT_TOKENS=8192
SIBYL_TEMPERATURE=0.7
# Lower temperature for conference templates and custom review forms.
SIBYL_FORM_TEMPERATURE=0.2

# Figures: a vision-language model (VLM) describes each figure image, and the reviewer reads the
# descriptions in place of the images. Defaults: qwen2.5vl:7b (ollama), Qwen/Qwen2.5-VL-7B-Instruct (vllm),
# none (openai: set it to a VLM your server runs). "none" disables the step. The VLM is downloaded on first
# use unless SIBYL_VLM_AUTO_PULL=false.
# SIBYL_VLM_MODEL=qwen2.5vl:7b
# SIBYL_VLM_AUTO_PULL=true
# SIBYL_VLM_MAX_FIGURES=24
# SIBYL_VLM_MAX_IMAGE_SIDE=1280

# Library search embeddings: "ollama" (nomic-embed-text, pulled automatically) or "local"
# (bundled MiniLM, no server). Defaults to ollama with the Ollama engine, local otherwise.
# SIBYL_EMBEDDINGS=ollama

# --- Ollama -----------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
# Multi-GPU: one Ollama server per GPU, comma separated (GPU n in the UI -> n-th host).
# OLLAMA_HOSTS=http://ollama-0:11434,http://ollama-1:11434
# How long a model stays loaded after a review ("0" frees VRAM immediately, "10m" avoids reloads).
OLLAMA_KEEP_ALIVE=0

# --- vLLM -------------------------------------------------------------------
# HF_TOKEN=hf_...                      # needed for gated models (Llama, Gemma)
# SIBYL_VLLM_COMMAND=vllm              # e.g. "/opt/vllm-venv/bin/vllm" or "uvx vllm"
# SIBYL_VLLM_GPUS=0,1,2,3              # default: all NVIDIA GPUs
# SIBYL_VLLM_GPU_MEMORY_UTILIZATION=0.80
# SIBYL_VLLM_BASE_PORT=8100            # GPU n listens on base + n
# SIBYL_VLLM_EXTRA_ARGS=--enable-prefix-caching
# SIBYL_VLLM_STARTUP_TIMEOUT=1200

# --- OpenAI-compatible server ------------------------------------------------
# SIBYL_OPENAI_BASE_URL=http://localhost:1234/v1   # LM Studio default
# SIBYL_OPENAI_API_KEY=

# --- GROBID (optional metadata extraction) ----------------------------------
GROBID_ENABLED=false
GROBID_URL=http://localhost:8070
