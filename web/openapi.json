          "name": {
            "type": "string",
            "title": "Name"
          },
          "full_name": {
            "type": "string",
            "title": "Full Name"
          },
          "area": {
            "type": "string",
            "title": "Area"
          },
          "edition": {
            "type": "string",
            "title": "Edition"
