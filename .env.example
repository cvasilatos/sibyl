# Ollama Configuration (local LLM)
# Model name - use any model you have pulled in Ollama
# Popular options: llama3.2, mistral, phi3, gemma2, qwen2.5, deepseek-coder
OLLAMA_MODEL=llama3.2

# Optional: Ollama base URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Optional: Model parameters
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=4000

# GROBID Configuration (for PDF metadata extraction)
# Set to true to enable GROBID for extracting title, authors, etc. when PDF metadata is empty
# Requires a running GROBID service (see: https://grobid.readthedocs.io/)
GROBID_ENABLED=false

# Optional: GROBID service URL (default: http://localhost:8070)
# You can run GROBID locally via Docker: docker run -t --rm -p 8070:8070 lfoppiano/grobid:0.8.0
GROBID_URL=http://localhost:8070
